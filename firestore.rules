
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SYSTEM HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function isAccountActive(companyId) {
      return getUserData(companyId).status == 'active';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function isSuperAdmin(companyId) {
      return isCompanyMember(companyId) && getUserData(companyId).roleId == 'super-admin';
    }

    function isCompanyAdmin(companyId) {
      let userData = getUserData(companyId);
      return userData.roleId == 'super-admin' || userData.roleId == 'admin';
    }

    function hasBranchAccess(companyId, branchId) {
      let userData = getUserData(companyId);
      return userData.roleId == 'super-admin' || branchId in userData.allowedBranches;
    }

    // --- MODULE RULES ---

    // 1. Audit Logs & History (Restricted)
    match /companies/{companyId}/audit_logs/{logId} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if isCompanyMember(companyId) && isAccountActive(companyId);
      allow update, delete: if false; 
    }

    // 2. User & Role Management (Super Protected)
    match /companies/{companyId}/users/{userId} {
      // Self-read always allowed for identity bootstrap
      allow read: if isSignedIn() && (request.auth.uid == userId || isCompanyAdmin(companyId));
      // Allow self-provisioning during bootstrap (can only create own profile)
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Only admins can modify user records (Roles, Status, Branches)
      allow write: if isCompanyAdmin(companyId);
      // Allow self-update for basic profile fields only
      allow update: if isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId', 'status', 'allowedBranches', 'permissionOverrides']);
    }

    match /companies/{companyId}/roles/{roleId} {
      allow read: if isCompanyMember(companyId);
      // Allow creation of the first super-admin role if it doesn't exist
      allow create: if isSignedIn() && (!exists(/databases/$(database)/documents/companies/$(companyId)/roles/super-admin) || isSuperAdmin(companyId));
      allow update, delete: if isSuperAdmin(companyId);
    }

    // 3. Branch Specific Data
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId) && isAccountActive(companyId) && hasBranchAccess(companyId, branchId);
    }

    // 4. Global Master Data
    match /companies/{companyId}/{collectionName}/{id} {
      allow read: if isCompanyMember(companyId);
      // Allow creation of first config
      allow create: if isSignedIn() && (collectionName == 'system' || isCompanyAdmin(companyId));
      allow write: if isCompanyAdmin(companyId) && isAccountActive(companyId);
      
      // Explicitly allow master data collections
      match collectionName in ['master_units', 'master_categories', 'master_brands', 'master_models', 'master_custom_fields', 'master_data'] {
        allow read: if isCompanyMember(companyId);
      }
    }

    // 5. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
