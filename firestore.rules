
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company.
    // For the demo corporation, we allow all signed-in users for testing purposes.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- RULES ---

    // Root-level Super Admin profiles
    match /super_admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
    }

    // Multi-tenant Company Hierarchy
    // Using a recursive wildcard at the company level ensures that if you are a member
    // of a company, you have access to all its nested data (branches, invoices, products, etc.)
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isMember(companyId);
    }

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
