
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- BASE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Helper to check if user belongs to the company
    function isCompanyMember(companyId) {
      return isSignedIn() && (
        companyId == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    // --- TENANT DATA RULES ---

    // Root level company access
    match /companies/{companyId} {
      // Allow reading the company doc itself if signed in
      allow get: if isSignedIn();
      
      // Recursive rule for ALL sub-collections (branches, users, invoices, etc.)
      match /{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }
    }

    // --- GLOBAL ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // --- DEFAULT DENY ---

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
