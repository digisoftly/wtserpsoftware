
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        companyId == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    function matchesTenant(companyId) {
      return request.resource.data.companyId == companyId;
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId) || isSuperAdmin();
      allow create: if isSignedIn() && (companyId == "warrior-demo-corp" || isSuperAdmin());
      allow update: if isCompanyMember(companyId) || isSuperAdmin();

      match /system/{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /roles/{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /users/{userId} {
        allow get: if isCompanyMember(companyId) || isSuperAdmin() || request.auth.uid == userId;
        allow list: if isCompanyMember(companyId) || isSuperAdmin();
        allow create, update: if (isCompanyMember(companyId) || isSuperAdmin()) && matchesTenant(companyId);
      }

      match /brands/{brandId} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /models/{modelId} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /branches/{branchId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow write: if isCompanyMember(companyId) || isSuperAdmin();

        match /{allPaths=**} {
          allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
        }
      }
    }

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
