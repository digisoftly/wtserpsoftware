
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company
    // For the demo corporation, we allow all signed-in users for testing.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- RULES ---

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // Multi-tenant Company Hierarchy
    match /companies/{companyId} {
      // Allow read/write to the company document and ALL nested sub-collections recursively
      allow read, write: if isMember(companyId);

      match /{allPaths=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // Individual User Profile (Allow creation during onboarding)
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin Profile Management
    match /super_admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
