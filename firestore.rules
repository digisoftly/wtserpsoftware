
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company.
    // For the demo, we allow all signed-in users to access the demo tenant.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    // --- RULES ---

    // Public read for branding/config
    match /companies/{companyId}/system/config {
      allow read: if true;
    }

    // Recursive rule for all company data (branches, invoices, products, etc.)
    // This allows listing documents in any sub-collection if isMember is true.
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isMember(companyId);
    }

    // Root level user preferences
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
