
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- BASE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        companyId == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    // --- TENANT DATA RULES ---

    // Matches the company document and everything underneath it (branches, invoices, etc.)
    match /companies/{companyId} {
      allow read, write: if isCompanyMember(companyId) || isSuperAdmin();

      match /{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }
      
      // Explicit rules for user creation and profile management
      match /users/{userId} {
        allow create: if isSignedIn() && (companyId == "warrior-demo-corp" || isSuperAdmin());
        allow get, update: if request.auth.uid == userId || isSuperAdmin();
      }
    }

    // --- GLOBAL ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // --- DEFAULT DENY ---

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
