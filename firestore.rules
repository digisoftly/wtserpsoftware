
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company.
    // We allow all signed-in users access to the "warrior-demo-corp" tenant for testing.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      // Safely check for super admin status
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- RULES ---

    // Allow public read of system configuration for branding on Login Page
    match /companies/{companyId}/system/config {
      allow read: if true;
    }

    // Allow users to read/write their own profile metadata
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Multi-tenant Company Hierarchy
    match /companies/{companyId} {
      // Members can read/write everything within their company scope
      allow read, write: if isMember(companyId);
      
      // Ensure recursive access to all sub-collections (branches, products, invoices, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
