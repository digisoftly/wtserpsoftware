
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(companyId, userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // --- RULES ---

    // 1. System Configuration (Public Read)
    match /companies/{companyId}/system/config {
      allow read: if true;
      allow write: if isCompanyMember(companyId);
    }

    // 2. User Profiles (Owner Access)
    // Critical for first-time profile creation and login
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 3. Warrior Demo Corp (Full access for prototyping)
    match /companies/warrior-demo-corp/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 4. Standard Company Data (Membership Restricted)
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId);
    }

    // 5. Root Level User Preferences
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 6. Global Super Admin Bypass
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // 7. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
