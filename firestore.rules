
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SYSTEM HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Fetches the user document to check core attributes
    function getUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Checks if user is an admin for a specific company
    function isCompanyAdmin(companyId) {
      // Safely check if the user doc exists first to prevent rules evaluation errors
      let userDocPath = /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid);
      return exists(userDocPath) && (get(userDocPath).data.roleId == 'super-admin' || get(userDocPath).data.roleId == 'admin');
    }

    // Validates branch-level access
    function hasBranchAccess(companyId, branchId) {
      let userData = getUserData(companyId);
      return userData.roleId == 'super-admin' || branchId in userData.allowedBranches;
    }

    // --- MODULE RULES ---

    // 1. Audit Logs & History (Admin Only)
    match /companies/{companyId}/audit_logs/{logId} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if isCompanyMember(companyId); // System logs its own actions
      allow update, delete: if false; // Immutable logs
    }

    match /companies/{companyId}/login_history/{id} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if true; // Login trigger
      allow update, delete: if false;
    }

    // 2. Organization Master Config
    match /companies/{companyId}/system/config {
      allow read: if true;
      allow write: if isCompanyAdmin(companyId);
    }

    // 3. User & Role Management
    match /companies/{companyId}/users/{userId} {
      // Allow users to read their own doc if signed in, or admins to read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isCompanyAdmin(companyId) || isCompanyMember(companyId));
      // Allow users to update their own doc (basic profile) or admins to manage all
      allow write: if isCompanyAdmin(companyId) || (isSignedIn() && request.auth.uid == userId);
    }

    match /companies/{companyId}/roles/{roleId} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    // 4. Branch Specific Data
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read, write: if hasBranchAccess(companyId, branchId);
    }

    // 5. Global Master Data
    match /companies/{companyId}/master_data/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/master_units/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/master_categories/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/master_brands/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/master_models/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/master_custom_fields/{id} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyAdmin(companyId);
    }

    // 6. Root Level User Preferences
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 7. Global Super Admin Bypass
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // 8. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
