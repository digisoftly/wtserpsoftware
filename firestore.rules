
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // --- RULES ---

    // Public read for branding/config
    match /companies/{companyId}/system/config {
      allow read: if true;
    }

    // Explicitly allow users to read/write their own profile in the company context
    // This solves the 'chicken-and-egg' problem where they need a profile to read company data
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Robust recursive rule for the demo company
    // Grants full access to all sub-collections for signed-in users
    match /companies/warrior-demo-corp/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Rule for other companies (if any)
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isSignedIn() && (
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // Root level user preferences
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
