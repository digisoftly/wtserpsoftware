
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WARRIOR ERP SECURITY RULES
     * 
     * Core Philosophy: 
     * This ruleset implements a strict multi-tenant isolation model. Access is governed by a user's 
     * association with a specific Company and Branch. Global access is reserved for Super Admins 
     * verified via an "existence-over-content" check in a dedicated collection.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isSpecificUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Verifies that a user is a member of the specified company.
     * PROTOTYPE EXCEPTION: Allows authenticated users access to the demo company.
     * OPTIMIZATION: Check hardcoded demo ID first to avoid unnecessary exists() calls.
     */
    function isCompanyMember(companyId) {
      return isSignedIn() && (
        companyId == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    function matchesTenant(companyId) {
      return request.resource.data.companyId == companyId;
    }

    function matchesBranch(companyId, branchId) {
      return matchesTenant(companyId) && request.resource.data.branchId == branchId;
    }

    function isExistingDoc() {
      return resource != null;
    }

    // --- SUPER ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (isSpecificUser(userId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // --- SYSTEM SETTINGS RULES ---

    match /system_settings/{allPaths=**} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // --- COMPANY & BRANCH RULES ---

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      
      // ALLOW DEMO CORP CREATION
      allow create: if isSuperAdmin() || (isSignedIn() && companyId == "warrior-demo-corp");
      allow update: if isCompanyMember(companyId) || isSuperAdmin();

      // SYSTEM CONFIG
      match /system/{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      // ROLES & PERMISSIONS
      match /roles/{roleId} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /branches/{branchId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow write: if isSuperAdmin() || (companyId == "warrior-demo-corp" && matchesTenant(companyId));

        match /{collection}/{docId} {
          allow get, list: if isCompanyMember(companyId) || isSuperAdmin();
          allow create: if (isCompanyMember(companyId) || isSuperAdmin()) 
                        && (companyId == "warrior-demo-corp" || matchesBranch(companyId, branchId));
          allow update: if (isCompanyMember(companyId) || isSuperAdmin()) 
                        && isExistingDoc() 
                        && (companyId == "warrior-demo-corp" || request.resource.data.companyId == resource.data.companyId);
          allow delete: if (isCompanyMember(companyId) || isSuperAdmin()) 
                        && isExistingDoc();

          match /{subCollection}/{subDocId} {
            allow get, list: if isCompanyMember(companyId) || isSuperAdmin();
            allow create: if (isCompanyMember(companyId) || isSuperAdmin()) 
                          && (companyId == "warrior-demo-corp" || matchesBranch(companyId, branchId));
            allow update: if (isCompanyMember(companyId) || isSuperAdmin()) 
                          && isExistingDoc() 
                          && (companyId == "warrior-demo-corp" || request.resource.data.companyId == resource.data.companyId);
            allow delete: if (isCompanyMember(companyId) || isSuperAdmin()) 
                          && isExistingDoc();
          }
        }
      }

      match /users/{userId} {
        allow get: if isCompanyMember(companyId) || isSuperAdmin() || isSpecificUser(userId);
        allow list: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if (isSpecificUser(userId) || isSuperAdmin() || companyId == "warrior-demo-corp") && matchesTenant(companyId);
        allow update: if (isSpecificUser(userId) || isSuperAdmin() || companyId == "warrior-demo-corp") && isExistingDoc();
        allow delete: if isSuperAdmin() && isExistingDoc();
      }

      match /audit_logs/{logId} {
        allow get, list: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isSignedIn() && matchesTenant(companyId);
        allow update, delete: if false; 
      }
    }

    // --- FALLBACK ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
