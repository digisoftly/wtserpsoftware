
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- RULES ---

    // 1. Public Configuration
    match /companies/{companyId}/system/config {
      allow read: if true;
    }

    // 2. User Profiles (Owner Access)
    // Users must be able to read/write their own profile to join a company context
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Unified Company Data Rule
    // Handles both the Demo Company (Public to signed-in users) 
    // and Private Companies (Profile/Admin restricted)
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isSignedIn() && (
        companyId == 'warrior-demo-corp' ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // 4. Global User Preferences (Root Level)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 5. Global Bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // 6. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
