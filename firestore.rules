
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- BASE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Helper to check if user belongs to the company
    function isCompanyMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    // --- TENANT DATA RULES ---

    match /companies/{companyId} {
      // Allow reading the company document itself for any signed-in user
      allow get: if isSignedIn();
      
      // Recursive rule for ALL sub-collections (branches, users, invoices, etc.)
      // This ensures that list/get/create/update/delete operations are allowed
      // for any authenticated member of the company.
      match /{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      // Explicitly handle branch discovery and listing
      match /branches/{branchId} {
        allow list: if isCompanyMember(companyId) || isSuperAdmin();
        
        match /{branchResources=**} {
          allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
        }
      }
    }

    // --- GLOBAL ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // --- DEFAULT DENY ---

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
