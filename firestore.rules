
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SYSTEM HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely checks if the user is a super admin
    function isSuperAdmin(companyId) {
      return isSignedIn() && (
        request.auth.token.email == 'warriortechsystem@gmail.com' || 
        (exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.roleId == 'super-admin')
      );
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        isSuperAdmin(companyId) || 
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    function getUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function isCompanyAdmin(companyId) {
      if (isSuperAdmin(companyId)) return true;
      return exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)) && 
             (getUserData(companyId).roleId == 'admin' || getUserData(companyId).roleId == 'manager');
    }

    function hasBranchAccess(companyId, branchId) {
      if (isSuperAdmin(companyId)) return true;
      let userData = getUserData(companyId);
      return branchId in userData.allowedBranches;
    }

    // --- MODULE RULES ---

    // 1. Audit & History
    match /companies/{companyId}/audit_logs/{id} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if isSignedIn();
    }

    match /companies/{companyId}/login_history/{id} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if isSignedIn();
    }

    // 2. User & Role Management
    match /companies/{companyId}/users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCompanyAdmin(companyId));
      allow create, update: if isSuperAdmin(companyId) || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isSuperAdmin(companyId);
    }

    match /companies/{companyId}/roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin(companyId);
    }

    // 3. Branch Specific Data (Sales, Inventory, Quotations etc.)
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId) && hasBranchAccess(companyId, branchId);
    }

    // 4. Global Master Data & System Config
    match /companies/{companyId}/{collectionName}/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin(companyId);
    }

    // 5. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
