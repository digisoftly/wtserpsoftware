
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- BASE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        companyId == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
      );
    }

    // --- TENANT DATA RULES ---

    // Unified rule for all company-related data
    // This allows recursive access to branches, products, invoices, etc.
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
    }

    // Explicit rules for user profile management (ensuring privacy while allowing company checks)
    match /companies/{companyId}/users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isCompanyMember(companyId) || isSuperAdmin());
      allow list: if isCompanyMember(companyId) || isSuperAdmin();
      allow create: if isSignedIn() && (companyId == "warrior-demo-corp" || isSuperAdmin());
      allow update: if request.auth.uid == userId || isSuperAdmin();
    }

    // --- GLOBAL ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // --- DEFAULT DENY ---

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
