
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company.
    // For the demo corporation, we allow all signed-in users for testing purposes.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- RULES ---

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // Root-level Super Admin profiles
    match /super_admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
    }

    // Multi-tenant Company Hierarchy
    // This recursive match ensures that if you are a member of a company,
    // you can read/write to the company document and ALL nested sub-collections (branches, products, invoices, etc.)
    match /companies/{companyId} {
      allow read, write: if isMember(companyId);

      match /{allPaths=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // User Profile - Ensure users can always manage their own identity within a company
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Default Deny (Optional but good practice to keep it explicit)
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
