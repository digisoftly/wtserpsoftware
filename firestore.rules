
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SYSTEM HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function isAccountActive(companyId) {
      return getUserData(companyId).status == 'active';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function isSuperAdmin(companyId) {
      return isCompanyMember(companyId) && getUserData(companyId).roleId == 'super-admin';
    }

    function isCompanyAdmin(companyId) {
      let userData = getUserData(companyId);
      return userData.roleId == 'super-admin' || userData.roleId == 'admin';
    }

    function hasBranchAccess(companyId, branchId) {
      let userData = getUserData(companyId);
      return userData.roleId == 'super-admin' || branchId in userData.allowedBranches;
    }

    // --- MODULE RULES ---

    // 1. Audit Logs & History
    match /companies/{companyId}/audit_logs/{logId} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if isCompanyMember(companyId);
      allow update, delete: if false; 
    }

    // 2. User & Role Management
    match /companies/{companyId}/users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCompanyAdmin(companyId));
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/roles/{roleId} {
      // Allow reading roles to check existance during bootstrap
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update, delete: if isSuperAdmin(companyId);
    }

    // 3. Branch Specific Data
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId) && hasBranchAccess(companyId, branchId);
    }

    // 4. Global Master Data & System Config
    match /companies/{companyId}/{collectionName}/{id} {
      // Allow reading config for bootstrap state check
      allow read: if isSignedIn();
      
      // Allow first-time setup
      allow create: if isSignedIn() && (collectionName == 'system' || collectionName == 'master_data');
      
      allow write: if isCompanyAdmin(companyId);
    }

    // 5. Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
