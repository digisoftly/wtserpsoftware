
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- BASE HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Helper to check if user belongs to the company
    // For the demo corporation, we allow all signed-in users for testing purposes.
    // For others, we check for the existence of their user document in that company.
    function isCompanyMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" ||
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    // --- TENANT DATA RULES ---

    // Apply recursive rules to the entire company hierarchy
    match /companies/{companyId} {
      // Allow individual operations and recursive access if a member or super admin
      allow read, write: if isCompanyMember(companyId) || isSuperAdmin();

      match /{allPaths=**} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      // Explicitly allow users to manage their own profile for onboarding
      match /users/{userId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isCompanyMember(companyId) || isSuperAdmin());
      }
    }

    // --- GLOBAL ADMIN RULES ---

    match /super_admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // --- DEFAULT DENY ---

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
