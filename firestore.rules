
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member if they belong to the specific company.
    // We allow all signed-in users access to the "warrior-demo-corp" tenant for testing.
    function isMember(cid) {
      return isSignedIn() && (
        cid == "warrior-demo-corp" || 
        exists(/databases/$(database)/documents/companies/$(cid)/users/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- RULES ---

    // Allow public read of system configuration for branding on Login Page
    match /companies/{companyId}/system/config {
      allow read: if true;
      allow write: if isMember(companyId);
    }

    // User Profile Access
    match /companies/{companyId}/users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isMember(companyId));
    }

    // Global Roles Access
    match /companies/{companyId}/roles/{roleId} {
      allow read: if isSignedIn() && isMember(companyId);
      allow write: if isMember(companyId);
    }

    // Branch and Sub-collection Access
    // Unified recursive match to ensure all sub-collections (like invoices/challans) are accessible
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read, write: if isMember(companyId);
    }

    // Root collections
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global bypass for Super Admins
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // Default Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
