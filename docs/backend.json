
{
  "entities": {
    "MasterUnit": {
      "title": "Master Unit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      }
    },
    "MasterCategory": {
      "title": "Master Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "MasterBrand": {
      "title": "Master Brand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "MasterModel": {
      "title": "Master Model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "CustomField": {
      "title": "Custom Field Definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "number", "dropdown", "date", "checkbox", "textarea"] },
        "targetModule": { "type": "string", "enum": ["product", "customer", "supplier", "project", "contract", "hrm"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "isRequired": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      }
    },
    "GenericMaster": {
      "title": "Generic Master Entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "type": { "type": "string" }
      }
    },
    "Product": {
      "title": "Inventory Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "categoryId": { "type": "string" },
        "brandId": { "type": "string" },
        "unitId": { "type": "string" },
        "unitPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "serialNumberTrackingRequired": { "type": "boolean" }
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "projectCode": { "type": "string" },
        "customerId": { "type": "string" },
        "status": { "type": "string" },
        "budget": { "type": "number" },
        "paidAmount": { "type": "number" },
        "progress": { "type": "number" }
      }
    },
    "SalesInvoice": {
      "title": "Sales Invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "ServiceContract": {
      "title": "Service Contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "status": { "type": "string" },
        "monthlyAmount": { "type": "number" }
      }
    },
    "ContractInvoice": {
      "title": "Contract Monthly Invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractId": { "type": "string" },
        "billingMonth": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Employee Profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "department": { "type": "string" },
        "employmentStatus": { "type": "string" }
      }
    },
    "Lead": {
      "title": "CRM Lead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Transaction": {
      "title": "Financial Transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "transactionType": { "type": "string", "enum": ["income", "expense"] },
        "transactionDate": { "type": "string", "format": "date-time" }
      }
    },
    "Quotation": {
      "title": "Sales Quotation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "Return": {
      "title": "Sales or Purchase Return",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentNumber": { "type": "string" },
        "totalAmount": { "type": "number" },
        "reason": { "type": "string" },
        "type": { "type": "string", "enum": ["sales", "purchase"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/companies/{companyId}/system/config": { "schema": "object", "description": "Global system settings." },
    "/companies/{companyId}/master_units/{id}": { "schema": { "$ref": "#/backend/entities/MasterUnit" }, "description": "Global quantity units." },
    "/companies/{companyId}/master_categories/{id}": { "schema": { "$ref": "#/backend/entities/MasterCategory" }, "description": "Global product categories." },
    "/companies/{companyId}/master_brands/{id}": { "schema": { "$ref": "#/backend/entities/MasterBrand" }, "description": "Global brands." },
    "/companies/{companyId}/master_models/{id}": { "schema": { "$ref": "#/backend/entities/MasterModel" }, "description": "Global models linked to brands." },
    "/companies/{companyId}/master_custom_fields/{id}": { "schema": { "$ref": "#/backend/entities/CustomField" }, "description": "Dynamic custom fields." },
    "/companies/{companyId}/master_data/{id}": { "schema": { "$ref": "#/backend/entities/GenericMaster" }, "description": "Centralized storage for various master modules like WarrantyTypes, Tax, etc." },
    "/companies/{companyId}/users/{userId}": { "schema": "object", "description": "Company-specific user profiles." },
    "/companies/{companyId}/roles/{roleId}": { "schema": "object", "description": "Access control roles." },
    "/companies/{companyId}/branches/{branchId}": { "schema": "object", "description": "Business locations." },
    "/companies/{companyId}/branches/{branchId}/products/{id}": { "schema": { "$ref": "#/backend/entities/Product" }, "description": "Inventory catalog." },
    "/companies/{companyId}/branches/{branchId}/employees/{id}": { "schema": { "$ref": "#/backend/entities/Employee" }, "description": "Staff directory." },
    "/companies/{companyId}/branches/{branchId}/projects/{id}": { "schema": { "$ref": "#/backend/entities/Project" }, "description": "Client projects." },
    "/companies/{companyId}/branches/{branchId}/sales_invoices/{id}": { "schema": { "$ref": "#/backend/entities/SalesInvoice" }, "description": "Sales records." },
    "/companies/{companyId}/branches/{branchId}/delivery_challans/{id}": { "schema": "object", "description": "Dispatch records." },
    "/companies/{companyId}/branches/{branchId}/service_contracts/{id}": { "schema": { "$ref": "#/backend/entities/ServiceContract" }, "description": "Maintenance agreements." },
    "/companies/{companyId}/branches/{branchId}/contract_invoices/{id}": { "schema": { "$ref": "#/backend/entities/ContractInvoice" }, "description": "Periodic billing for contracts." },
    "/companies/{companyId}/branches/{branchId}/leads/{id}": { "schema": { "$ref": "#/backend/entities/Lead" }, "description": "Sales prospects." },
    "/companies/{companyId}/branches/{branchId}/tickets/{id}": { "schema": { "$ref": "#/backend/entities/SupportTicket" }, "description": "Customer support cases." },
    "/companies/{companyId}/branches/{branchId}/transactions/{id}": { "schema": { "$ref": "#/backend/entities/Transaction" }, "description": "Account journals." },
    "/companies/{companyId}/branches/{branchId}/quotations/{id}": { "schema": { "$ref": "#/backend/entities/Quotation" }, "description": "Sales proposals." },
    "/companies/{companyId}/branches/{branchId}/sales_returns/{id}": { "schema": { "$ref": "#/backend/entities/Return" }, "description": "Customer returns." },
    "/companies/{companyId}/branches/{branchId}/purchase_returns/{id}": { "schema": { "$ref": "#/backend/entities/Return" }, "description": "Supplier returns." },
    "/companies/{companyId}/branches/{branchId}/purchase_orders/{id}": { "schema": "object", "description": "Inventory procurement." },
    "/companies/{companyId}/branches/{branchId}/serial_numbers/{id}": { "schema": "object", "description": "Individual unit tracking." },
    "/companies/{companyId}/branches/{branchId}/project_payments/{id}": { "schema": "object", "description": "Project settlement records." },
    "/companies/{companyId}/branches/{branchId}/project_expenses/{id}": { "schema": "object", "description": "Costs associated with projects." }
  }
}
