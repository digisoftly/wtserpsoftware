
{
  "entities": {
    "Company": {
      "title": "Company",
      "type": "object",
      "description": "Represents a single company within the multi-tenant ERP system.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currencyCode": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currencyCode", "isActive", "createdAt"]
    },
    "Brand": {
      "title": "Product Brand",
      "type": "object",
      "description": "Manufacturer or brand name.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Model": {
      "title": "Product Model",
      "type": "object",
      "description": "Specific model line within a brand.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "brandId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "companyId", "brandId", "name"]
    },
    "Category": {
      "title": "Product Category",
      "type": "object",
      "description": "Categorization for products (e.g., CCTV, Networking).",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a physical location or warehouse.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "managerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "companyId", "name", "code"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a physical product or service.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "branchId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "unitPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "serialNumberTrackingRequired": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "sku", "unitPrice", "serialNumberTrackingRequired"]
    },
    "SalesInvoice": {
      "title": "Sales Invoice",
      "type": "object",
      "description": "Customer billing record.",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "due", "partial", "void"] },
        "invoiceDate": { "type": "string" }
      }
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "type": "object",
      "description": "Stock procurement record.",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["ordered", "received", "cancelled"] }
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "description": "Long-term client project.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "customerId": { "type": "string" },
        "budget": { "type": "number" },
        "paidAmount": { "type": "number" },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "completed"] }
      }
    },
    "ServiceContract": {
      "title": "Service Contract",
      "type": "object",
      "description": "Recurring service agreement.",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "serviceName": { "type": "string" },
        "customerId": { "type": "string" },
        "monthlyAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "cancelled"] }
      }
    },
    "ContractInvoice": {
      "title": "Contract Invoice",
      "type": "object",
      "description": "Generated invoice for a specific contract month.",
      "properties": {
        "id": { "type": "string" },
        "contractId": { "type": "string" },
        "amount": { "type": "number" },
        "billingMonth": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "due"] }
      }
    },
    "Customer": {
      "title": "Customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" }
      }
    },
    "Supplier": {
      "title": "Supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "totalDueAmount": { "type": "number" }
      }
    },
    "Role": {
      "title": "Access Role",
      "type": "object",
      "description": "Defines permissions.",
      "properties": {
        "name": { "type": "string" },
        "isSuperAdmin": { "type": "boolean" },
        "permissions": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/companies/{companyId}/system/config",
        "definition": {
          "entityName": "SystemConfig",
          "description": "Global ERP settings."
        }
      },
      {
        "path": "/companies/{companyId}/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "Company staff profiles."
        }
      },
      {
        "path": "/companies/{companyId}/roles/{roleId}",
        "definition": {
          "entityName": "Role",
          "description": "Access control levels."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}",
        "definition": {
          "entityName": "Branch",
          "description": "Branch locations."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "description": "Branch inventory items."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/sales_invoices/{invoiceId}",
        "definition": {
          "entityName": "SalesInvoice",
          "description": "Sales records."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "description": "Client projects."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/service_contracts/{contractId}",
        "definition": {
          "entityName": "ServiceContract",
          "description": "SLA agreements."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/contract_invoices/{invoiceId}",
        "definition": {
          "entityName": "ContractInvoice",
          "description": "Monthly contract billing."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "description": "Customer profiles."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "description": "Supplier profiles."
        }
      }
    ]
  }
}
