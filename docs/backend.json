
{
  "entities": {
    "MasterUnit": {
      "title": "Master Unit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "isDefault": { "type": "boolean" }
      }
    },
    "MasterCategory": {
      "title": "Master Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "MasterBrand": {
      "title": "Master Brand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "MasterModel": {
      "title": "Master Model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "CustomField": {
      "title": "Custom Field Definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "number", "dropdown", "date", "checkbox", "textarea"] },
        "targetModule": { "type": "string", "enum": ["product", "customer", "supplier", "project", "contract"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "isRequired": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/companies/{companyId}/branches/{branchId}/project_payments/{paymentId}": {
      "schema": { "type": "object" },
      "description": "Financial records for project-based revenue."
    },
    "/companies/{companyId}/master_units/{id}": { "schema": { "$ref": "#/backend/entities/MasterUnit" }, "description": "Global quantity units." },
    "/companies/{companyId}/master_categories/{id}": { "schema": { "$ref": "#/backend/entities/MasterCategory" }, "description": "Global product categories." },
    "/companies/{companyId}/master_brands/{id}": { "schema": { "$ref": "#/backend/entities/MasterBrand" }, "description": "Global brands." },
    "/companies/{companyId}/master_models/{id}": { "schema": { "$ref": "#/backend/entities/MasterModel" }, "description": "Global models linked to brands." },
    "/companies/{companyId}/master_custom_fields/{id}": { "schema": { "$ref": "#/backend/entities/CustomField" }, "description": "Dynamic custom fields for various modules." }
  }
}
