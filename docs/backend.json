
{
  "entities": {
    "Company": {
      "title": "Company",
      "type": "object",
      "description": "Represents a single company within the multi-tenant ERP system.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currencyCode": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currencyCode", "isActive", "createdAt"]
    },
    "Brand": {
      "title": "Product Brand",
      "type": "object",
      "description": "Manufacturer or brand name.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Model": {
      "title": "Product Model",
      "type": "object",
      "description": "Specific model line within a brand.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "brandId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "companyId", "brandId", "name"]
    },
    "Category": {
      "title": "Product Category",
      "type": "object",
      "description": "Categorization for products (e.g., CCTV, Networking).",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a physical location or warehouse.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "managerId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "companyId", "name", "code"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a physical product or service.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "branchId": { "type": "string" },
        "brandId": { "type": "string" },
        "modelId": { "type": "string" },
        "categoryId": { "type": "string" },
        "productType": { 
          "type": "string",
          "enum": ["hardware", "service", "software", "other"]
        },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "unitPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "serialNumberTrackingRequired": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "sku", "unitPrice", "productType", "serialNumberTrackingRequired"]
    },
    "ProductSerialNumber": {
      "title": "ProductSerialNumber",
      "type": "object",
      "description": "Tracks individual units by unique serial number.",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["available", "sold", "returned", "damaged", "under_service"] 
        },
        "saleInvoiceId": { "type": "string" },
        "purchaseOrderId": { "type": "string" }
      },
      "required": ["id", "productId", "serialNumber", "status"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "type": "object",
      "description": "Global ERP settings.",
      "properties": {
        "companyName": { "type": "string" },
        "taxRate": { "type": "number" },
        "currency": { "type": "string" },
        "invoicePrefix": { "type": "string" }
      }
    },
    "Role": {
      "title": "Access Role",
      "type": "object",
      "description": "Defines permissions.",
      "properties": {
        "name": { "type": "string" },
        "isSuperAdmin": { "type": "boolean" },
        "permissions": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/companies/{companyId}/brands/{brandId}",
        "definition": {
          "entityName": "Brand",
          "schema": { "$ref": "#/backend/entities/Brand" },
          "description": "Global product brands."
        }
      },
      {
        "path": "/companies/{companyId}/models/{modelId}",
        "definition": {
          "entityName": "Model",
          "schema": { "$ref": "#/backend/entities/Model" },
          "description": "Global product models."
        }
      },
      {
        "path": "/companies/{companyId}/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Global product categories."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}",
        "definition": {
          "entityName": "Branch",
          "schema": { "$ref": "#/backend/entities/Branch" },
          "description": "Branch details."
        }
      },
      {
        "path": "/companies/{companyId}/branches/{branchId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Branch inventory."
        }
      }
    ]
  }
}
