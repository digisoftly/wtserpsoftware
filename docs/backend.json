
{
  "entities": {
    "ProjectPayment": {
      "title": "Project Payment",
      "type": "object",
      "description": "Payment receipt for client projects.",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "totalPaid": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "allocationType": { "type": "string", "enum": ["auto", "manual"] },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": { "type": "string" },
              "projectName": { "type": "string" },
              "amountAllocated": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "customerId", "totalPaid", "paymentDate", "allocations"]
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "customerId": { "type": "string" },
        "budget": { "type": "number" },
        "paidAmount": { "type": "number" },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "completed"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/companies/{companyId}/branches/{branchId}/project_payments/{paymentId}": {
      "schema": { "$ref": "#/backend/entities/ProjectPayment" },
      "description": "Financial records for project-based revenue."
    },
    "/companies/{companyId}/branches/{branchId}/projects/{projectId}": {
      "schema": { "$ref": "#/backend/entities/Project" },
      "description": "Client installation projects."
    }
  }
}
